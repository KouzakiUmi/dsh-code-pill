{
  "name": "dsh-code-pill",
  "displayName": "Code Pill / Antigravity 风格代码渲染",
  "version": "0.7.1",
  "description": "Customizable inline code rendering for DSH: six paired light/dark presets, audited syntax palettes, optional file icons and badges, typography controls, Font Lab overrides, and dual-tab host-integrated settings.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "docs/",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "code",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "node": ">=18",
      "dshReleases": {
        "0.2.1-alpha.1": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-code-pill.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-code-pill#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-code-pill/issues"
  },
  "devDependencies": {
    "playwright-core": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
